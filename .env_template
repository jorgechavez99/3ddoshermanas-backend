# Copiar a .env y rellenar. Nunca subir .env al repositorio.
PORT=4010
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=tienda3d
# Clave larga y aleatoria para crear/editar productos (cabecera x-clave-admin).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_ADMIN=
# Dominios de la web que pueden llamar a la API, separados por comas.
ORIGEN_WEB=https://3ddoshermanas.com,https://www.3ddoshermanas.com
